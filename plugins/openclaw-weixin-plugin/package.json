{
  "name": "@claw-manager/openclaw-weixin",
  "version": "2026.8.3",
  "description": "OpenClaw Weixin channel",
  "license": "MIT",
  "author": "Tencent",
  "type": "module",
  "files": [
    "src/",
    "!src/**/*.test.ts",
    "!src/**/node_modules/",
    "index.ts",
    "openclaw.plugin.json",
    "dist/",
    "README.md",
    "README.zh_CN.md",
    "CHANGELOG.md",
    "CHANGELOG.zh_CN.md"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@claw-manager/document-parser": "2026.8.2",
    "qrcode-terminal": "0.12.0",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "openclaw": ">=2026.5.12"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/zhangsen540445123/claw-manager.git",
    "directory": "plugins/openclaw-weixin-plugin"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.1.0",
    "openclaw": "2026.5.12",
    "silk-wasm": "^3.7.1",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  },
  "openclaw": {
    "extensions": [
      "./index.ts"
    ],
    "runtimeExtensions": [
      "./dist/index.js"
    ],
    "channel": {
      "id": "openclaw-weixin",
      "label": "openclaw-weixin",
      "selectionLabel": "openclaw-weixin",
      "docsPath": "/channels/openclaw-weixin",
      "docsLabel": "openclaw-weixin",
      "blurb": "Weixin channel",
      "order": 75
    },
    "install": {
      "npmSpec": "@claw-manager/openclaw-weixin",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.5.12"
    }
  },
  "ilink_appid": "bot"
}
