<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.clawbotforall.miniapp.MiniappRequestNonceMapper">
  <insert id="insert">
    INSERT INTO miniapp_request_nonces (app_id, nonce, created_at, expires_at)
    VALUES (#{appId}, #{nonce}, #{createdAt}, #{expiresAt})
  </insert>

  <delete id="deleteExpired">
    DELETE FROM miniapp_request_nonces
    WHERE expires_at &lt;= #{now}
  </delete>
</mapper>
