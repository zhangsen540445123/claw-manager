CLAW_MANAGER_API_IMAGE=ghcr.io/zhangsen540445123/claw-manager-api:latest
CLAW_MANAGER_WEB_IMAGE=ghcr.io/zhangsen540445123/claw-manager-web:latest
OPENCLAW_RUNNER_IMAGE=ghcr.io/zhangsen540445123/claw-manager-openclaw-runner:latest

WEB_HOST_PORT=4300
API_HOST_PORT=8080
MYSQL_HOST_PORT=13306

MINIAPP_OPEN_API_BASE_URL=https://www.caoxf.nyc.mn/api
SESSION_TTL_DAYS=14
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=平台管理员
ADMIN_PASSWORD=ChangeMe123!

OPENCLAW_RUNNER_PULL_TIMEOUT_MS=600000
OPENCLAW_RUNNER_CPUS=1.0
OPENCLAW_RUNNER_MEMORY=2g
OPENCLAW_RUNNER_MEMORY_SWAP=4g
OPENCLAW_RUNNER_NODE_MAX_OLD_SPACE_MB=1536
OPENCLAW_WECHAT_BIND_TIMEOUT_MS=600000
OPENCLAW_GATEWAY_READY_TIMEOUT_MS=1800000
OPENCLAW_GATEWAY_READY_CHECK_INTERVAL_MS=10000
OPENCLAW_GATEWAY_READY_PROBE_TIMEOUT_MS=5000
OPENCLAW_CONTROL_UI_ALLOWED_ORIGINS=*

# OOM diagnostic collection (enabled for the current five-instance investigation)
CLAWBOT_OOM_DIAGNOSTICS_ENABLED=true
CLAWBOT_OOM_DIAGNOSTICS_INTERVAL_MS=30000
CLAWBOT_OOM_DIAGNOSTICS_RETENTION_DAYS=7
CLAWBOT_OOM_DIAGNOSTICS_METRICS_LIMIT_MIB=256
CLAWBOT_OOM_DIAGNOSTICS_MIN_FREE_DISK_GIB=30
CLAWBOT_OOM_HEAP_SNAPSHOT_INSTANCE_IDS=mskgjut8-696d76,mskgjwgm-cfd552,mskgk1at-0f66eb,mskgk7u2-b24856,mskgk332-da8bdb
CLAWBOT_OOM_HEAP_SNAPSHOT_MAX_COUNT=5
CLAWBOT_OOM_HEAP_SNAPSHOT_MAX_TOTAL_GIB=12
CLAWBOT_OOM_HEAP_SNAPSHOT_PER_INSTANCE_MAX_COUNT=1
CLAWBOT_OOM_HEAP_SNAPSHOT_MIN_INTERVAL_MS=600000
